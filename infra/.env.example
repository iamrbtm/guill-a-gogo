# =============================================================================
# Guill-a-Gogo environment reference (EXAMPLE ONLY — no real secrets)
# Copy to .env and fill in. Never commit the real .env.
# =============================================================================

# --- Core ---
# App environment: development | production
APP_ENV=development

# Database (PostgreSQL 17). In docker this is the service name `postgres`.
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_DB_PASSWORD@postgres:5432/guill
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=guill

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# --- Auth / WebAuthn (passkeys) ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Relying-party identity. MUST match the production hostname (no scheme/port).
RP_ID=localhost
# Expected WebAuthn origin(s), comma-separated. Use https:// in production.
RP_ORIGIN=http://localhost:3000
RP_NAME=Guill-a-Gogo

# Comma-separated allowed CORS origins (your Expo web / backend URLs).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Invitations / email ---
# Base URL the invitation link points to (Expo app / web deep link).
INVITATION_BASE_URL=https://app.guill.example/accept
# Email provider: console (logs) | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@guill.example
# SMTP (optional; for self-hosted relay or dev catcher like Mailpit)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- AI provider (optional, provider-neutral) ---
# none | openai | gemini  (default none — app works without AI)
AI_PROVIDER=none
# For an OpenAI-compatible endpoint (e.g. a local/self-hosted gateway),
# set AI_BASE_URL and AI_API_KEY. Kilocode is a coding assistant, not a
# callable API; point this at whatever OpenAI-compatible endpoint you use.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Maps / providers (optional; absent => graceful manual entry) ---
GOOGLE_MAPS_API_KEY=

# --- Operations ---
# Name of the EXISTING external reverse-proxy docker network the API joins.
EXTERNAL_NETWORK=webproxy_net
LOG_LEVEL=INFO
